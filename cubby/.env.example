# Supabase — add these to your .env file (or app.config.js)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Sentry crash reporting — get this from your Sentry project settings
# (sentry.io > your project > Settings > Client Keys (DSN)). If unset,
# Sentry is simply not initialized — no error, no crash.
EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# Google Places — powers the location search/autocomplete field on the host
# listing screen (src/components/LocationPicker.tsx / .web.tsx). If unset,
# the field silently shows zero suggestions and no error — see
# LocationPicker.tsx's own logging for why, once a request is actually sent.
# Create a DEDICATED key for this (do not reuse a Maps SDK for Android/iOS
# key — those use app-restriction types that don't work for this REST-based
# implementation): Google Cloud Console > APIs & Services > enable "Places
# API" (the classic one, not "Places API (New)") > Credentials > Create
# credentials > API key > API restrictions: Places API only > Application
# restrictions: None (app-restriction types can't apply to a plain fetch()
# call from a mobile client — API restriction is what actually scopes this
# key down).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your-places-api-key

# These go in Supabase Dashboard > Settings > Edge Functions > Secrets (NOT in .env):
# PEACH_PAYMENTS_TOKEN=your-peach-token
# PEACH_PAYMENTS_ENTITY_ID=your-entity-id
# PEACH_WEBHOOK_SECRET=your-webhook-secret
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ADMIN_SECRET=your-server-only-admin-secret       — server-to-server callers only, never in a client env var
# ADMIN_PIN=your-4-digit-admin-pin                 — read only by verify-admin-pin; never EXPO_PUBLIC_*, see app/(admin)/login.tsx
