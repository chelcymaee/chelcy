{
  "expo": {
    "name": "Cubby",
    "slug": "cubby",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "cubby",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7343F"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mycubby.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Cubby uses your location to find nearby luggage hosts.",
        "NSPhotoLibraryUsageDescription": "Cubby needs photo access so you can add profile and storage photos.",
        "NSCameraUsageDescription": "Cubby needs camera access to take photos of your storage space.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.cubby.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1A3C34",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDeOlqYoSUFwdPj-LgWqht_5_X2eXauQ2w"
        }
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-location",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cubby needs access to your photos to add storage space images."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#FF5C5C",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#F7343F",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "3982a56f-c3a1-4f7e-9f9c-8ce56aacbfb7"
      }
    }
  }
}
